+
+typedef struct {
+  int32_t values[OAI_SW_NB_PARAMS];
+  uint32_t version;
+  uint64_t t_applied_ns;
+} oai_sw_cfg_t;
+
+/* cfg and cfg_stats are written by the control thread (apply) and read by the data path (one snapshot per burst) */
+static pthread_mutex_t cfg_lock = PTHREAD_MUTEX_INITIALIZER;
+static oai_sw_cfg_t cfg; /* values set from the descriptor defaults in oai_sw_cfg_init() */
+static aal_compute_stats_t cfg_stats[AAL_COMPUTE_STATS_VERSIONS];
+/* created at probe, so that switching to par at runtime does not pay for thread creation; OAI_SW_MAX_WORKERS threads
+ * exist even in seq, at the thread pool's real-time priority when the process may set it */
+static tpool_t workers_pool;
+static bool workers_pool_ready;
+
+static uint64_t oai_sw_now_ns(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+/* starts the statistics of the version in force; called with cfg_lock held */
+static void cfg_stats_open(void)
+{
+  cfg_stats[cfg.version % AAL_COMPUTE_STATS_VERSIONS] =
+      (aal_compute_stats_t){.version = cfg.version, .t_applied_ns = cfg.t_applied_ns};
+}
+
+/* affinity of the thread that loads libldpc_aal.so, taken before rte_eal_init() pins the calling thread to the main
+ * lcore; in the OAI executables the library is loaded by the main thread, so this is the CPU set given to the process */
+static cpu_set_t loader_cpus;
+RTE_INIT(oai_sw_save_loader_cpus)
+{
+  if (sched_getaffinity(0, sizeof(loader_cpus), &loader_cpus) != 0)
+    CPU_ZERO(&loader_cpus);
+}
+
+/* worker CPUs: the loader CPUs minus the EAL lcores, the same rule EAL applies to its own control threads */
+static void workers_cpuset(cpu_set_t *set)
+{
+  *set = loader_cpus;
+  unsigned int lcore;
+  RTE_LCORE_FOREACH(lcore)
+  {
+    const rte_cpuset_t l = rte_lcore_cpuset(lcore);
+    for (int c = 0; c < CPU_SETSIZE; c++)
+      if (CPU_ISSET(c, &l))
+        CPU_CLR(c, set);
+  }
+  if (CPU_COUNT(set) == 0) /* no CPU left outside the lcores: share them */
+    *set = loader_cpus;
+}
+
+static void oai_sw_cfg_init(void)
+{
+  if (workers_pool_ready)
+    return;
+  /* this runs inside rte_eal_init() on the main lcore, and tpool threads inherit the affinity of their creator:
+   * without this, every worker would be pinned to the main lcore */
+  cpu_set_t workers, self;
+  workers_cpuset(&workers);
+  char list[256] = "";
+  for (int c = 0, n = 0; c < CPU_SETSIZE && n < (int)sizeof(list) - 8; c++)
+    if (CPU_ISSET(c, &workers))
+      n += snprintf(list + n, sizeof(list) - n, "%s%d", n ? "," : "", c);
+  const bool pinned = CPU_COUNT(&workers) > 0 && pthread_getaffinity_np(pthread_self(), sizeof(self), &self) == 0
+                      && pthread_setaffinity_np(pthread_self(), sizeof(workers), &workers) == 0;
+  initFloatingCoresTpool(OAI_SW_MAX_WORKERS, &workers_pool, false, "oai_sw_dec");
+  if (pinned)
+    pthread_setaffinity_np(pthread_self(), sizeof(self), &self);
+  workers_pool_ready = true;
+  OAI_SW_LOG("worker pool: %d threads, CPUs %s", OAI_SW_MAX_WORKERS, pinned ? list : "inherited (affinity unchanged)");
+  pthread_mutex_lock(&cfg_lock);
+  for (int i = 0; i < OAI_SW_NB_PARAMS; i++)
+    cfg.values[i] = oai_sw_params[i].default_value;
+  cfg.version = 1;
+  cfg.t_applied_ns = oai_sw_now_ns();
+  cfg_stats_open();
+  pthread_mutex_unlock(&cfg_lock);
+}
+
+static uint32_t oai_sw_compute_apply(const int32_t *values)
+{
+  pthread_mutex_lock(&cfg_lock);
+  memcpy(cfg.values, values, sizeof(cfg.values));
+  cfg.version++;
+  cfg.t_applied_ns = oai_sw_now_ns();
+  cfg_stats_open();
+  const uint32_t version = cfg.version;
+  pthread_mutex_unlock(&cfg_lock);
+  return version;
+}
+
+static uint32_t oai_sw_compute_get(int32_t *values, uint64_t *t_applied_ns)
+{
+  pthread_mutex_lock(&cfg_lock);
+  memcpy(values, cfg.values, sizeof(cfg.values));
+  *t_applied_ns = cfg.t_applied_ns;
+  const uint32_t version = cfg.version;
+  pthread_mutex_unlock(&cfg_lock);
+  return version;
+}
+
+static int oai_sw_compute_get_stats(aal_compute_stats_t *stats, int max)
+{
+  int n = 0;
+  pthread_mutex_lock(&cfg_lock);
+  for (uint32_t v = cfg.version; v > 0 && n < max && n < AAL_COMPUTE_STATS_VERSIONS; v--) {
+    const aal_compute_stats_t *s = &cfg_stats[v % AAL_COMPUTE_STATS_VERSIONS];
+    if (s->version == v)
+      stats[n++] = *s;
+  }
+  pthread_mutex_unlock(&cfg_lock);
+  return n;
+}
+
+static const aal_compute_lpu_ops_t oai_sw_compute = {
+    .lpu_handle = RTE_STR(DRIVER_NAME),
+    .nb_params = OAI_SW_NB_PARAMS,
+    .params = oai_sw_params,
+    .apply = oai_sw_compute_apply,
+    .get = oai_sw_compute_get,
+    .get_stats = oai_sw_compute_get_stats,
+};
+
+/* the AAL Implementation finds these parameters by driver name, without depending on this driver */
+RTE_INIT(oai_sw_compute_register)
+{
+  if (aal_compute_ext_register(&oai_sw_compute) != 0)
+    OAI_SW_LOG("cannot register the runtime parameters of %s", oai_sw_compute.lpu_handle);
+}
+
+static oai_sw_cfg_t oai_sw_cfg_snapshot(void)
+{
+  pthread_mutex_lock(&cfg_lock);
+  const oai_sw_cfg_t c = cfg;
+  pthread_mutex_unlock(&cfg_lock);
+  return c;
+}
+
+static void oai_sw_cfg_account(uint32_t version, uint64_t t_start, uint64_t t_end, uint16_t nb_ops)
+{
+  pthread_mutex_lock(&cfg_lock);
+  aal_compute_stats_t *s = &cfg_stats[version % AAL_COMPUTE_STATS_VERSIONS];
+  if (s->version == version) {
+    if (s->t_first_burst_ns == 0)
+      s->t_first_burst_ns = t_start;
+    s->nb_bursts++;
+    s->nb_ops += nb_ops;
+    s->busy_ns += t_end - t_start;
+  }
+  pthread_mutex_unlock(&cfg_lock);
+}
+
+typedef struct {
+  struct rte_bbdev_dec_op **ops;
+  uint16_t nb_ops;
+  uint16_t batch;
+  _Atomic(uint32_t) next;
+  task_ans_t ans;
+} oai_sw_dec_burst_t;
+
+/* each task takes the next batch of code blocks until the burst is exhausted */
+static void oai_sw_dec_worker(void *arg)
+{
+  oai_sw_dec_burst_t *b = arg;
+  for (uint32_t first = atomic_fetch_add(&b->next, b->batch); first < b->nb_ops; first = atomic_fetch_add(&b->next, b->batch)) {
+    const uint32_t last = RTE_MIN(first + b->batch, (uint32_t)b->nb_ops);
+    for (uint32_t i = first; i < last; i++)
+      process_ldpc_dec(b->ops[i]);
+  }
+  completed_task_ans(&b->ans);
+}
+
+static void oai_sw_dec_parallel(struct rte_bbdev_dec_op **ops, uint16_t nb_ops, int workers, int batch)
+{
+  oai_sw_dec_burst_t b = {.ops = ops, .nb_ops = nb_ops, .batch = batch};
+  atomic_init(&b.next, 0);
+  const int nb_tasks = RTE_MIN(workers, (nb_ops + batch - 1) / batch);
+  init_task_ans(&b.ans, nb_tasks);
+  for (int t = 0; t < nb_tasks; t++)
+    pushTpool(&workers_pool, (task_t){.func = oai_sw_dec_worker, .args = &b});
+  join_task_ans(&b.ans);
+}
+#endif
+
+/* ------------------------------------------------------------------------ */
+/* Advertised capabilities                                                   */
+/* ------------------------------------------------------------------------ */
+static const struct rte_bbdev_op_cap oai_sw_capabilities[] = {
+    {
+        .type = RTE_BBDEV_OP_LDPC_ENC,
+        .cap.ldpc_enc =
+            {
+                .capability_flags = RTE_BBDEV_LDPC_RATE_MATCH,
+                .num_buffers_src = RTE_BBDEV_LDPC_MAX_CODE_BLOCKS,
+                .num_buffers_dst = RTE_BBDEV_LDPC_MAX_CODE_BLOCKS,
+            },
+    },
+    {
+        .type = RTE_BBDEV_OP_LDPC_DEC,
+        .cap.ldpc_dec =
+            {
+                .capability_flags = RTE_BBDEV_LDPC_ITERATION_STOP_ENABLE | RTE_BBDEV_LDPC_CRC_TYPE_24B_DROP
+                                    | RTE_BBDEV_LDPC_CRC_TYPE_24B_CHECK | RTE_BBDEV_LDPC_HQ_COMBINE_IN_ENABLE
+                                    | RTE_BBDEV_LDPC_HQ_COMBINE_OUT_ENABLE | RTE_BBDEV_LDPC_INTERNAL_HARQ_MEMORY_IN_ENABLE
+                                    | RTE_BBDEV_LDPC_INTERNAL_HARQ_MEMORY_OUT_ENABLE,
+                .llr_size = 8,
+                .llr_decimals = 0,
+                .num_buffers_src = RTE_BBDEV_LDPC_MAX_CODE_BLOCKS,
+                .num_buffers_hard_out = RTE_BBDEV_LDPC_MAX_CODE_BLOCKS,
+                .num_buffers_soft_out = 0,
+            },
+    },
+    RTE_BBDEV_END_OF_CAPABILITIES_LIST()};
+
+/* ------------------------------------------------------------------------ */
+/* Control path                                                              */
+/* ------------------------------------------------------------------------ */
+struct oai_sw_private {
+  unsigned int max_nb_queues;
+};
+
+struct __rte_cache_aligned oai_sw_queue {
+  struct rte_ring *ring; /* processed ops waiting for dequeue */
+};
+
+static void oai_sw_info_get(struct rte_bbdev *dev, struct rte_bbdev_driver_info *dev_info)
+{
+  struct oai_sw_private *priv = dev->data->dev_private;
+
+  static struct rte_bbdev_queue_conf default_queue_conf = {
+      .queue_size = RTE_BBDEV_QUEUE_SIZE_LIMIT,
+  };
+  default_queue_conf.socket = dev->data->socket_id;
+
+  dev_info->driver_name = RTE_STR(DRIVER_NAME);
+  dev_info->max_num_queues = priv->max_nb_queues;
+  dev_info->num_queues[RTE_BBDEV_OP_LDPC_ENC] = priv->max_nb_queues;
+  dev_info->num_queues[RTE_BBDEV_OP_LDPC_DEC] = priv->max_nb_queues;
+  dev_info->queue_priority[RTE_BBDEV_OP_LDPC_ENC] = OAI_SW_QUEUE_PRIO_MAX;
+  dev_info->queue_priority[RTE_BBDEV_OP_LDPC_DEC] = OAI_SW_QUEUE_PRIO_MAX;
+  dev_info->max_dl_queue_priority = OAI_SW_QUEUE_PRIO_MAX;
+  dev_info->max_ul_queue_priority = OAI_SW_QUEUE_PRIO_MAX;
+  dev_info->queue_size_lim = RTE_BBDEV_QUEUE_SIZE_LIMIT;
+  dev_info->hardware_accelerated = false;
+  dev_info->default_queue_conf = default_queue_conf;
+  dev_info->capabilities = oai_sw_capabilities;
+  dev_info->cpu_flag_reqs = NULL;
+  dev_info->min_alignment = 1;
+  dev_info->harq_buffer_size = 0;
+  dev_info->data_endianness = RTE_LITTLE_ENDIAN;
+  dev_info->device_status = RTE_BBDEV_DEV_NOSTATUS;
+}
+
+static int oai_sw_queue_setup(struct rte_bbdev *dev, uint16_t q_id, const struct rte_bbdev_queue_conf *conf)
+{
+  char ring_name[RTE_RING_NAMESIZE];
+  snprintf(ring_name, sizeof(ring_name), "oai_sw_%u_%u", dev->data->dev_id, q_id);
+
+  struct oai_sw_queue *q = rte_zmalloc_socket(ring_name, sizeof(*q), RTE_CACHE_LINE_SIZE, conf->socket);
+  if (q == NULL)
+    return -ENOMEM;
+
+  q->ring = rte_ring_create(ring_name, conf->queue_size, conf->socket, RING_F_SP_ENQ | RING_F_SC_DEQ);
+  if (q->ring == NULL) {
+    rte_free(q);
+    return -EFAULT;
+  }
+
+  dev->data->queues[q_id].queue_private = q;
+  OAI_SW_LOG("queue %u configured (op_type=%s, size=%u)", q_id, rte_bbdev_op_type_str(conf->op_type), conf->queue_size);
+  return 0;
+}
+
+static int oai_sw_queue_release(struct rte_bbdev *dev, uint16_t q_id)
+{
+  struct oai_sw_queue *q = dev->data->queues[q_id].queue_private;
+  if (q != NULL) {
+    rte_ring_free(q->ring);
+    rte_free(q);
+    dev->data->queues[q_id].queue_private = NULL;
+  }
+  return 0;
+}
+
+static const struct rte_bbdev_ops oai_sw_ops = {
+    .info_get = oai_sw_info_get,
+    .queue_setup = oai_sw_queue_setup,
+    .queue_release = oai_sw_queue_release,
+};
+
+/* ------------------------------------------------------------------------ */
+/* Data path: process on enqueue, return on dequeue                          */
+/* ------------------------------------------------------------------------ */
+/* enqueue call/op counts, printed at exit: evidence that a run went through this device */
+static uint64_t stats_dec_calls, stats_dec_ops, stats_enc_calls, stats_enc_ops;
+static void stats_report(void)
+{
+  OAI_SW_LOG("summary: DEC %lu calls / %lu ops | ENC %lu calls / %lu ops",
+             stats_dec_calls,
+             stats_dec_ops,
+             stats_enc_calls,
+             stats_enc_ops);
+}
+RTE_INIT(stats_register)
+{
+  atexit(stats_report);
+}
+
+static uint16_t ring_enqueue(struct rte_bbdev_queue_data *q_data, void **ops, uint16_t nb_ops)
+{
+  struct oai_sw_queue *q = q_data->queue_private;
+  uint16_t n = rte_ring_enqueue_burst(q->ring, ops, nb_ops, NULL);
+  q_data->queue_stats.enqueue_err_count += nb_ops - n;
+  q_data->queue_stats.enqueued_count += n;
+  return n;
+}
+
+static uint16_t ring_dequeue(struct rte_bbdev_queue_data *q_data, void **ops, uint16_t nb_ops)
+{
+  struct oai_sw_queue *q = q_data->queue_private;
+  uint16_t n = rte_ring_dequeue_burst(q->ring, ops, nb_ops, NULL);
+  q_data->queue_stats.dequeued_count += n;
+  return n;
+}
+
+static uint16_t oai_sw_enqueue_ldpc_dec(struct rte_bbdev_queue_data *q_data, struct rte_bbdev_dec_op **ops, uint16_t nb_ops)
+{
+  stats_dec_calls++;
+  stats_dec_ops += nb_ops;
+#ifdef ENABLE_LDPC_AAL_EXT
+  /* the configuration in force when the burst starts applies to the whole burst */
+  const oai_sw_cfg_t c = oai_sw_cfg_snapshot();
+  const uint64_t t_start = oai_sw_now_ns();
+  if (c.values[OAI_SW_PARAM_MODE] == OAI_SW_MODE_PAR && nb_ops > 1) {
+    oai_sw_dec_parallel(ops, nb_ops, c.values[OAI_SW_PARAM_WORKERS], c.values[OAI_SW_PARAM_BATCH]);
+  } else {
+    for (uint16_t i = 0; i < nb_ops; i++)
+      process_ldpc_dec(ops[i]);
+  }
+  oai_sw_cfg_account(c.version, t_start, oai_sw_now_ns(), nb_ops);
+#else
+  for (uint16_t i = 0; i < nb_ops; i++)
+    process_ldpc_dec(ops[i]);
+#endif
+  return ring_enqueue(q_data, (void **)ops, nb_ops);
+}
+
+static uint16_t oai_sw_dequeue_ldpc_dec(struct rte_bbdev_queue_data *q_data, struct rte_bbdev_dec_op **ops, uint16_t nb_ops)
+{
+  return ring_dequeue(q_data, (void **)ops, nb_ops);
+}
+
+static uint16_t oai_sw_enqueue_ldpc_enc(struct rte_bbdev_queue_data *q_data, struct rte_bbdev_enc_op **ops, uint16_t nb_ops)
+{
+  stats_enc_calls++;
+  stats_enc_ops += nb_ops;
+  for (uint16_t i = 0; i < nb_ops; i++)
+    process_ldpc_enc(ops[i]);
+  return ring_enqueue(q_data, (void **)ops, nb_ops);
+}
+
+static uint16_t oai_sw_dequeue_ldpc_enc(struct rte_bbdev_queue_data *q_data, struct rte_bbdev_enc_op **ops, uint16_t nb_ops)
+{
+  return ring_dequeue(q_data, (void **)ops, nb_ops);
+}
+
+/* ------------------------------------------------------------------------ */
+/* vdev probe / remove                                                       */
+/* ------------------------------------------------------------------------ */
+static int oai_sw_probe(struct rte_vdev_device *vdev)
+{
+  const char *name = rte_vdev_device_name(vdev);
+  if (name == NULL)
+    return -EINVAL;
+
+  if (oai_sw_load_kernels() != 0)
+    return -ENOENT;
+
+  struct rte_bbdev *bbdev = rte_bbdev_allocate(name);
+  if (bbdev == NULL)
+    return -ENODEV;
+
+  int socket_id = rte_socket_id();
+  struct oai_sw_private *priv = rte_zmalloc_socket(name, sizeof(*priv), RTE_CACHE_LINE_SIZE, socket_id);
+  if (priv == NULL) {
+    rte_bbdev_release(bbdev);
+    return -ENOMEM;
+  }
+  priv->max_nb_queues = OAI_SW_MAX_QUEUES;
+
+  bbdev->data->dev_private = priv;
+  bbdev->dev_ops = &oai_sw_ops;
+  bbdev->device = &vdev->device;
+  bbdev->data->socket_id = socket_id;
+  bbdev->intr_handle = NULL;
+
+  bbdev->enqueue_ldpc_dec_ops = oai_sw_enqueue_ldpc_dec;
+  bbdev->dequeue_ldpc_dec_ops = oai_sw_dequeue_ldpc_dec;
+  bbdev->enqueue_ldpc_enc_ops = oai_sw_enqueue_ldpc_enc;
+  bbdev->dequeue_ldpc_enc_ops = oai_sw_dequeue_ldpc_enc;
+
+#ifdef ENABLE_LDPC_AAL_EXT
+  oai_sw_cfg_init();
+#endif
+  OAI_SW_LOG("device %s created (LDPC_ENC + LDPC_DEC, %u queues, internal HARQ)", name, priv->max_nb_queues);
+  return 0;
+}
+
+static int oai_sw_remove(struct rte_vdev_device *vdev)
+{
+  const char *name = rte_vdev_device_name(vdev);
+  if (name == NULL)
+    return -EINVAL;
+  struct rte_bbdev *bbdev = rte_bbdev_get_named_dev(name);
+  if (bbdev == NULL)
+    return -EINVAL;
+#ifdef ENABLE_LDPC_AAL_EXT
+  if (workers_pool_ready) {
+    abortTpool(&workers_pool);
+    workers_pool_ready = false;
+  }
+#endif
+  rte_free(bbdev->data->dev_private);
+  return rte_bbdev_release(bbdev);
+}
+
+static struct rte_vdev_driver oai_sw_drv = {
+    .probe = oai_sw_probe,
+    .remove = oai_sw_remove,
+};
+
+RTE_PMD_REGISTER_VDEV(DRIVER_NAME, oai_sw_drv);
