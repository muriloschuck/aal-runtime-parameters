index 0000000000..4435982c31
--- /dev/null
+++ b/openair1/PHY/CODING/nrLDPC_coding/nrLDPC_coding_aal/aal_compute_ext.c
@@ -0,0 +1,711 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*
+ * AAL compute extension, AAL Implementation side.
+ *
+ * The AALI-C-App operations below are served on a UNIX stream socket, one request per line, one JSON object per
+ * response line:
+ *
+ *   getAalLpuComputeCapabilities
+ *   setAalLpuComputeConfig [expected_version=<v>] <name>=<value> ...
+ *   getAalLpuComputeConfig
+ *   getAalLpuComputeStats
+ *   setAalAccelConfig limits=<file>
+ *
+ * setAalAccelConfig stands for the AALI-C-Mgmt path (IMS -> HAM): it loads the infrastructure limits, one
+ * "<name> <min> <max>" line per parameter. The effective domain of a parameter is its descriptor domain (min, max,
+ * step) intersected with its limit; a limit that leaves the domain empty is rejected, and a value in force that falls
+ * outside a new limit is clamped to it.
+ *
+ * A set request is validated as a whole before anything is applied: either every value is applied, in one new
+ * configuration version, or none is.
+ *
+ * The control thread serves one client at a time; a connection is closed once the client closes it.
+ */
+
+#include "aal_compute_ext.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <poll.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "assertions.h"
+#include "common/utils/LOG/log.h"
+#include "common/utils/system.h"
+
+#define AAL_EXT_LINE_MAX 1024
+#define AAL_EXT_RESPONSE_MAX 16384
+#define AAL_EXT_MAX_TOKENS 32
+#define AAL_EXT_MAX_LPUS 8
+/* period at which the control thread checks for shutdown while waiting on the socket */
+#define AAL_EXT_POLL_MS 100
+
+typedef enum {
+  AAL_EXT_OK,
+  AAL_EXT_BAD_REQUEST,
+  AAL_EXT_UNKNOWN_PARAM,
+  AAL_EXT_INVALID_TYPE,
+  AAL_EXT_OUT_OF_RANGE,
+  AAL_EXT_LIMIT_EXCEEDED,
+  AAL_EXT_VERSION_CONFLICT,
+  AAL_EXT_INTERNAL_ERROR,
+} aal_ext_status_t;
+
+static const char *const aal_ext_status_str[] = {
+    [AAL_EXT_OK] = "OK",
+    [AAL_EXT_BAD_REQUEST] = "BAD_REQUEST",
+    [AAL_EXT_UNKNOWN_PARAM] = "UNKNOWN_PARAM",
+    [AAL_EXT_INVALID_TYPE] = "INVALID_TYPE",
+    [AAL_EXT_OUT_OF_RANGE] = "OUT_OF_RANGE",
+    [AAL_EXT_LIMIT_EXCEEDED] = "LIMIT_EXCEEDED",
+    [AAL_EXT_VERSION_CONFLICT] = "VERSION_CONFLICT",
+    [AAL_EXT_INTERNAL_ERROR] = "INTERNAL_ERROR",
+};
+
+static const char *const aal_ext_type_str[] = {
+    [AAL_COMPUTE_TYPE_INT] = "INT",
+    [AAL_COMPUTE_TYPE_ENUM] = "ENUM",
+    [AAL_COMPUTE_TYPE_BOOL] = "BOOL",
+};
+
+static const char *const aal_ext_category_str[] = {
+    [AAL_COMPUTE_CATEGORY_PARALLELISM] = "PARALLELISM",
+    [AAL_COMPUTE_CATEGORY_BATCHING] = "BATCHING",
+    [AAL_COMPUTE_CATEGORY_MEMORY] = "MEMORY",
+    [AAL_COMPUTE_CATEGORY_OTHER] = "OTHER",
+};
+
+static const char *const aal_ext_scope_str[] = {
+    [AAL_COMPUTE_SCOPE_LPU] = "LPU",
+    [AAL_COMPUTE_SCOPE_PROFILE_INSTANCE] = "PROFILE_INSTANCE",
+    [AAL_COMPUTE_SCOPE_PROFILE_QUEUE] = "PROFILE_QUEUE",
+};
+
+typedef struct {
+  bool set;
+  int32_t min;
+  int32_t max;
+} aal_ext_limit_t;
+
+/* written by LPU drivers from their load-time constructors, read by aal_compute_ext_init() */
+static const aal_compute_lpu_ops_t *registry[AAL_EXT_MAX_LPUS];
+static int nb_registered;
+
+/* only the control thread touches this state after aal_compute_ext_init() returns */
+static struct {
+  const aal_compute_lpu_ops_t *lpu; /* NULL: the LPU publishes no runtime parameters */
+  aal_ext_limit_t limits[AAL_COMPUTE_MAX_PARAMS];
+  uint32_t descriptor_version;
+  int listen_fd;
+  char sock_path[sizeof(((struct sockaddr_un *)0)->sun_path)];
+  pthread_t thread;
+  atomic_bool stop;
+} ext = {.listen_fd = -1};
+
+int aal_compute_ext_register(const aal_compute_lpu_ops_t *ops)
+{
+  if (ops == NULL || ops->lpu_handle == NULL || nb_registered == AAL_EXT_MAX_LPUS)
+    return -1;
+  for (int i = 0; i < nb_registered; i++)
+    if (strcmp(registry[i]->lpu_handle, ops->lpu_handle) == 0)
+      return -1;
+  registry[nb_registered++] = ops;
+  return 0;
+}
+
+static const aal_compute_lpu_ops_t *lpu_ops_for_driver(const char *driver_name)
+{
+  for (int i = 0; i < nb_registered; i++)
+    if (strcmp(registry[i]->lpu_handle, driver_name) == 0)
+      return registry[i];
+  return NULL;
+}
+
+typedef struct {
+  char buf[AAL_EXT_RESPONSE_MAX];
+  size_t len;
+  bool truncated;
+} aal_ext_json_t;
+
+static void json_append(aal_ext_json_t *j, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+static void json_append(aal_ext_json_t *j, const char *fmt, ...)
+{
+  if (j->truncated)
+    return;
+  va_list ap;
+  va_start(ap, fmt);
+  const int n = vsnprintf(j->buf + j->len, sizeof(j->buf) - j->len, fmt, ap);
+  va_end(ap);
+  if (n < 0 || j->len + n >= sizeof(j->buf))
+    j->truncated = true;
+  else
+    j->len += n;
+}
+
+/* appends s as a JSON string; request tokens are echoed through here, so they cannot break the response */
+static void json_append_str(aal_ext_json_t *j, const char *s)
+{
+  json_append(j, "\"");
+  for (; *s != '\0'; s++) {
+    const unsigned char c = *s;
+    if (c == '"' || c == '\\')
+      json_append(j, "\\%c", c);
+    else if (c < 0x20)
+      json_append(j, "\\u%04x", c);
+    else
+      json_append(j, "%c", c);
+  }
+  json_append(j, "\"");
+}
+
+static int nb_params(void)
+{
+  return ext.lpu ? ext.lpu->nb_params : 0;
+}
+
+static int find_param(const char *name)
+{
+  for (int i = 0; i < nb_params(); i++)
+    if (strcmp(ext.lpu->params[i].name, name) == 0)
+      return i;
+  return -1;
+}
+
+static int32_t param_step(const aal_compute_param_t *p)
+{
+  return p->step > 1 ? p->step : 1;
+}
+
+/*
+ * Effective domain of parameter i under the limit lim: the values of the descriptor grid (min + k * step, up to max)
+ * that lie within lim. Returns false if no value is left.
+ */
+static bool domain_under_limit(int i, const aal_ext_limit_t *lim, int32_t *min, int32_t *max)
+{
+  const aal_compute_param_t *p = &ext.lpu->params[i];
+  const int64_t step = param_step(p);
+  int64_t lo = p->min;
+  int64_t hi = p->max;
+  if (lim->set) {
+    if (lim->min > lo)
+      lo = p->min + (lim->min - p->min + step - 1) / step * step;
+    if (lim->max < hi)
+      hi = lim->max;
+  }
+  hi = p->min + (hi - p->min) / step * step;
+  if (lo > hi)
+    return false;
+  *min = lo;
+  *max = hi;
+  return true;
+}
+
+static void effective_domain(int i, int32_t *min, int32_t *max)
+{
+  /* load_limits() only accepts limits that leave every domain non-empty */
+  const bool non_empty = domain_under_limit(i, &ext.limits[i], min, max);
+  DevAssert(non_empty);
+}
+
+static aal_ext_status_t parse_value(const aal_compute_param_t *p, const char *s, int32_t *value)
+{
+  switch (p->type) {
+    case AAL_COMPUTE_TYPE_ENUM:
+      for (int k = 0; k < p->nb_enum_values; k++)
+        if (strcmp(p->enum_values[k], s) == 0) {
+          *value = k;
+          return AAL_EXT_OK;
+        }
+      return AAL_EXT_INVALID_TYPE;
+    case AAL_COMPUTE_TYPE_BOOL:
+      if (strcmp(s, "true") == 0 || strcmp(s, "1") == 0)
+        *value = 1;
+      else if (strcmp(s, "false") == 0 || strcmp(s, "0") == 0)
+        *value = 0;
+      else
+        return AAL_EXT_INVALID_TYPE;
+      return AAL_EXT_OK;
+    case AAL_COMPUTE_TYPE_INT: {
+      char *end;
+      errno = 0;
+      const long v = strtol(s, &end, 10);
+      if (errno != 0 || end == s || *end != '\0' || v < INT32_MIN || v > INT32_MAX)
+        return AAL_EXT_INVALID_TYPE;
+      *value = v;
+      return AAL_EXT_OK;
+    }
+  }
+  return AAL_EXT_INVALID_TYPE;
+}
+
+static aal_ext_status_t check_value(int i, int32_t value)
+{
+  const aal_compute_param_t *p = &ext.lpu->params[i];
+  if (value < p->min || value > p->max || (value - p->min) % param_step(p) != 0)
+    return AAL_EXT_OUT_OF_RANGE;
+  int32_t min, max;
+  effective_domain(i, &min, &max);
+  if (value < min || value > max)
+    return AAL_EXT_LIMIT_EXCEEDED;
+  return AAL_EXT_OK;
+}
+
+static void json_value(aal_ext_json_t *j, int i, int32_t value)
+{
+  const aal_compute_param_t *p = &ext.lpu->params[i];
+  if (p->type == AAL_COMPUTE_TYPE_ENUM)
+    json_append_str(j, p->enum_values[value]);
+  else if (p->type == AAL_COMPUTE_TYPE_BOOL)
+    json_append(j, "%s", value ? "true" : "false");
+  else
+    json_append(j, "%d", value);
+}
+
+static bool parse_u32(const char *s, uint32_t *v)
+{
+  char *end;
+  errno = 0;
+  const unsigned long long x = strtoull(s, &end, 10);
+  if (errno != 0 || end == s || *end != '\0' || *s == '-' || x > UINT32_MAX)
+    return false;
+  *v = x;
+  return true;
+}
+
+/*
+ * Validates every name=value token against the current values and, only if all are valid, applies them in one
+ * version. On error, *bad_token points to the offending token (its name, for name=value tokens).
+ */
+static aal_ext_status_t set_config(char **tokens, int nb_tokens, const char **bad_token, uint32_t *version)
+{
+  int32_t values[AAL_COMPUTE_MAX_PARAMS];
+  bool seen[AAL_COMPUTE_MAX_PARAMS] = {false};
+  int nb_values = 0;
+  uint64_t t_applied_ns;
+  const uint32_t current_version = ext.lpu ? ext.lpu->get(values, &t_applied_ns) : 0;
+  *version = current_version;
+  *bad_token = "";
+  for (int t = 0; t < nb_tokens; t++) {
+    *bad_token = tokens[t];
+    char *eq = strchr(tokens[t], '=');
+    if (eq == NULL)
+      return AAL_EXT_BAD_REQUEST;
+    *eq = '\0';
+    const char *name = tokens[t];
+    const char *s = eq + 1;
+    if (strcmp(name, "expected_version") == 0) {
+      uint32_t expected;
+      if (!parse_u32(s, &expected))
+        return AAL_EXT_BAD_REQUEST;
+      if (expected != current_version)
+        return AAL_EXT_VERSION_CONFLICT;
+      continue;
+    }
+    const int i = find_param(name);
+    if (i < 0)
+      return AAL_EXT_UNKNOWN_PARAM;
+    if (seen[i])
+      return AAL_EXT_BAD_REQUEST;
+    seen[i] = true;
+    int32_t v;
+    aal_ext_status_t st = parse_value(&ext.lpu->params[i], s, &v);
+    if (st == AAL_EXT_OK)
+      st = check_value(i, v);
+    if (st != AAL_EXT_OK)
+      return st;
+    values[i] = v;
+    nb_values++;
+  }
+  /* a request that changes nothing does not create a version */
+  if (nb_values == 0)
+    return AAL_EXT_BAD_REQUEST;
+  *bad_token = NULL;
+  *version = ext.lpu->apply(values);
+  return AAL_EXT_OK;
+}
+
+/*
+ * Loads "<name> <min> <max>" lines; the limits replace the previous ones only if the whole file is valid and leaves
+ * every parameter with a non-empty effective domain.
+ */
+static int load_limits(const char *path)
+{
+  FILE *f = fopen(path, "r");
+  if (f == NULL) {
+    LOG_E(NR_PHY, "AAL compute extension: cannot open limits file %s: %s\n", path, strerror(errno));
+    return -1;
+  }
+  aal_ext_limit_t limits[AAL_COMPUTE_MAX_PARAMS] = {0};
+  char line[AAL_EXT_LINE_MAX];
+  int line_nb = 0;
+  int ret = 0;
+  while (ret == 0 && fgets(line, sizeof(line), f) != NULL) {
+    line_nb++;
+    char name[AAL_EXT_LINE_MAX];
+    long min, max;
+    char *hash = strchr(line, '#');
+    if (hash != NULL)
+      *hash = '\0';
+    const int n = sscanf(line, "%1023s %ld %ld", name, &min, &max);
+    if (n <= 0)
+      continue;
+    const int i = find_param(name);
+    int32_t emin, emax;
+    if (n != 3 || i < 0 || min > max || min < INT32_MIN || max > INT32_MAX)
+      ret = -1;
+    else if (!domain_under_limit(i, &(aal_ext_limit_t){.set = true, .min = min, .max = max}, &emin, &emax))
+      ret = -1; /* the limit excludes every value the LPU accepts */
+    else
+      limits[i] = (aal_ext_limit_t){.set = true, .min = min, .max = max};
+    if (ret != 0)
+      LOG_E(NR_PHY, "AAL compute extension: %s:%d: invalid limit\n", path, line_nb);
+  }
+  fclose(f);
+  if (ret == 0)
+    memcpy(ext.limits, limits, sizeof(ext.limits));
+  return ret;
+}
+
+/* Clamps the values in force to the effective domain; returns the number of parameters adjusted. */
+static int clamp_to_limits(uint32_t *version, aal_ext_json_t *adjusted)
+{
+  int32_t values[AAL_COMPUTE_MAX_PARAMS];
+  uint64_t t_applied_ns;
+  *version = ext.lpu ? ext.lpu->get(values, &t_applied_ns) : 0;
+  int nb_adjusted = 0;
+  for (int i = 0; i < nb_params(); i++) {
+    int32_t min, max;
+    effective_domain(i, &min, &max);
+    /* min and max lie on the descriptor grid, so the clamped value is a valid one */
+    const int32_t v = values[i] < min ? min : (values[i] > max ? max : values[i]);
+    if (v != values[i]) {
+      json_append(adjusted, "%s", nb_adjusted ? "," : "");
+      json_append_str(adjusted, ext.lpu->params[i].name);
+      values[i] = v;
+      nb_adjusted++;
+    }
+  }
+  if (nb_adjusted > 0)
+    *version = ext.lpu->apply(values);
+  return nb_adjusted;
+}
+
+static void op_get_capabilities(aal_ext_json_t *r)
+{
+  json_append(r, ",\"status\":\"OK\",\"aal_lpu_handle\":");
+  json_append_str(r, ext.lpu ? ext.lpu->lpu_handle : "");
+  json_append(r, ",\"descriptor_version\":%u,\"params\":[", ext.descriptor_version);
+  for (int i = 0; i < nb_params(); i++) {
+    const aal_compute_param_t *p = &ext.lpu->params[i];
+    int32_t min, max;
+    effective_domain(i, &min, &max);
+    json_append(r, "%s{\"name\":", i ? "," : "");
+    json_append_str(r, p->name);
+    json_append(r, ",\"type\":\"%s\"", aal_ext_type_str[p->type]);
+    if (p->type == AAL_COMPUTE_TYPE_ENUM) {
+      json_append(r, ",\"values\":[");
+      for (int k = min; k <= max; k++) {
+        json_append(r, "%s", k > min ? "," : "");
+        json_append_str(r, p->enum_values[k]);
+      }
+      json_append(r, "]");
+    } else if (p->type == AAL_COMPUTE_TYPE_INT) {
+      json_append(r, ",\"min\":%d,\"max\":%d,\"step\":%d", min, max, param_step(p));
+    }
+    json_append(r, ",\"default\":");
+    json_value(r, i, p->default_value);
+    if (p->unit != NULL && p->unit[0] != '\0') {
+      json_append(r, ",\"unit\":");
+      json_append_str(r, p->unit);
+    }
+    json_append(r,
+                ",\"category\":\"%s\",\"scope\":\"%s\",\"description\":",
+                aal_ext_category_str[p->category],
+                aal_ext_scope_str[p->scope]);
+    json_append_str(r, p->description != NULL ? p->description : "");
+    json_append(r, "}");
+  }
+  json_append(r, "]");
+}
+
+static void op_get_config(aal_ext_json_t *r)
+{
+  int32_t values[AAL_COMPUTE_MAX_PARAMS];
+  uint64_t t_applied_ns = 0;
+  const uint32_t version = ext.lpu ? ext.lpu->get(values, &t_applied_ns) : 0;
+  json_append(r, ",\"status\":\"OK\",\"version\":%u,\"t_applied_ns\":%" PRIu64 ",\"values\":{", version, t_applied_ns);
+  for (int i = 0; i < nb_params(); i++) {
+    json_append(r, "%s", i ? "," : "");
+    json_append_str(r, ext.lpu->params[i].name);
+    json_append(r, ":");
+    json_value(r, i, values[i]);
+  }
+  json_append(r, "}");
+}
+
+static void op_get_stats(aal_ext_json_t *r)
+{
+  aal_compute_stats_t stats[AAL_COMPUTE_STATS_VERSIONS];
+  const int n = ext.lpu ? ext.lpu->get_stats(stats, AAL_COMPUTE_STATS_VERSIONS) : 0;
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  json_append(r, ",\"status\":\"OK\",\"now_ns\":%" PRIu64 ",\"versions\":[", (uint64_t)(ts.tv_sec * 1000000000LL + ts.tv_nsec));
+  for (int k = 0; k < n; k++)
+    json_append(r,
+                "%s{\"version\":%u,\"t_applied_ns\":%" PRIu64 ",\"t_first_burst_ns\":%" PRIu64 ",\"bursts\":%" PRIu64
+                ",\"ops\":%" PRIu64 ",\"busy_ns\":%" PRIu64 "}",
+                k ? "," : "",
+                stats[k].version,
+                stats[k].t_applied_ns,
+                stats[k].t_first_burst_ns,
+                stats[k].nb_bursts,
+                stats[k].nb_ops,
+                stats[k].busy_ns);
+  json_append(r, "]");
+}
+
+static void op_set_config(char **tokens, int nb_tokens, aal_ext_json_t *r)
+{
+  const char *bad_token;
+  uint32_t version;
+  const aal_ext_status_t st = set_config(tokens, nb_tokens, &bad_token, &version);
+  json_append(r, ",\"status\":\"%s\",\"version\":%u", aal_ext_status_str[st], version);
+  if (st != AAL_EXT_OK) {
+    json_append(r, ",\"param\":");
+    json_append_str(r, bad_token);
+  }
+}
+
+static void op_set_accel_config(char **tokens, int nb_tokens, aal_ext_json_t *r)
+{
+  if (nb_tokens != 1 || strncmp(tokens[0], "limits=", strlen("limits=")) != 0 || load_limits(tokens[0] + strlen("limits=")) != 0) {
+    json_append(r, ",\"status\":\"%s\"", aal_ext_status_str[AAL_EXT_BAD_REQUEST]);
+    return;
+  }
+  ext.descriptor_version++;
+  aal_ext_json_t adjusted = {0};
+  uint32_t version;
+  clamp_to_limits(&version, &adjusted);
+  json_append(r,
+              ",\"status\":\"OK\",\"descriptor_version\":%u,\"version\":%u,\"adjusted\":[%s]",
+              ext.descriptor_version,
+              version,
+              adjusted.buf);
+}
+
+static void handle_request(char *line, aal_ext_json_t *r)
+{
+  char *tokens[AAL_EXT_MAX_TOKENS];
+  int nb_tokens = 0;
+  char *save;
+  for (char *t = strtok_r(line, " \t\r", &save); t != NULL; t = strtok_r(NULL, " \t\r", &save)) {
+    if (nb_tokens == AAL_EXT_MAX_TOKENS) {
+      json_append(r, "{\"op\":\"\",\"status\":\"%s\"}\n", aal_ext_status_str[AAL_EXT_BAD_REQUEST]);
+      return;
+    }
+    tokens[nb_tokens++] = t;
+  }
+  if (nb_tokens == 0) {
+    json_append(r, "{\"op\":\"\",\"status\":\"%s\"}\n", aal_ext_status_str[AAL_EXT_BAD_REQUEST]);
+    return;
+  }
+  const char *op = tokens[0];
+  json_append(r, "{\"op\":");
+  json_append_str(r, op);
+  if (strcmp(op, "getAalLpuComputeCapabilities") == 0 && nb_tokens == 1)
+    op_get_capabilities(r);
+  else if (strcmp(op, "setAalLpuComputeConfig") == 0)
+    op_set_config(tokens + 1, nb_tokens - 1, r);
+  else if (strcmp(op, "getAalLpuComputeConfig") == 0 && nb_tokens == 1)
+    op_get_config(r);
+  else if (strcmp(op, "getAalLpuComputeStats") == 0 && nb_tokens == 1)
+    op_get_stats(r);
+  else if (strcmp(op, "setAalAccelConfig") == 0)
+    op_set_accel_config(tokens + 1, nb_tokens - 1, r);
+  else
+    json_append(r, ",\"status\":\"%s\"", aal_ext_status_str[AAL_EXT_BAD_REQUEST]);
+  json_append(r, "}\n");
+}
+
+/* waits until fd is readable or shutdown is requested; returns false on shutdown */
+static bool wait_readable(int fd)
+{
+  struct pollfd pfd = {.fd = fd, .events = POLLIN};
+  while (!atomic_load(&ext.stop)) {
+    const int n = poll(&pfd, 1, AAL_EXT_POLL_MS);
+    if (n > 0)
+      return true;
+    if (n < 0 && errno != EINTR)
+      return false;
+  }
+  return false;
+}
+
+/* MSG_NOSIGNAL: a client that closes early must not raise SIGPIPE, whose default action ends the whole process */
+static bool send_all(int fd, const char *buf, size_t len)
+{
+  while (len > 0) {
+    const ssize_t n = send(fd, buf, len, MSG_NOSIGNAL);
+    if (n < 0 && errno == EINTR)
+      continue;
+    if (n <= 0)
+      return false;
+    buf += n;
+    len -= n;
+  }
+  return true;
+}
+
+static void serve_client(int fd)
+{
+  char line[AAL_EXT_LINE_MAX];
+  size_t len = 0;
+  while (wait_readable(fd)) {
+    const ssize_t n = read(fd, line + len, sizeof(line) - 1 - len);
+    if (n <= 0)
+      return;
+    len += n;
+    char *nl;
+    while ((nl = memchr(line, '\n', len)) != NULL) {
+      *nl = '\0';
+      static aal_ext_json_t r; /* 16 KiB, only used by the control thread */
+      r = (aal_ext_json_t){0};
+      handle_request(line, &r);
+      if (r.truncated) {
+        LOG_E(NR_PHY, "AAL compute extension: response longer than %d bytes\n", AAL_EXT_RESPONSE_MAX);
+        r = (aal_ext_json_t){0};
+        json_append(&r, "{\"op\":\"\",\"status\":\"%s\"}\n", aal_ext_status_str[AAL_EXT_INTERNAL_ERROR]);
+      }
+      if (!send_all(fd, r.buf, r.len))
+        return;
+      len -= nl + 1 - line;
+      memmove(line, nl + 1, len);
+    }
+    if (len == sizeof(line) - 1) {
+      LOG_W(NR_PHY, "AAL compute extension: request longer than %d bytes, closing connection\n", AAL_EXT_LINE_MAX - 1);
+      return;
+    }
+  }
+}
+
+static void *ctl_thread(void *arg)
+{
+  while (wait_readable(ext.listen_fd)) {
+    const int fd = accept(ext.listen_fd, NULL, NULL);
+    if (fd < 0)
+      continue;
+    serve_client(fd);
+    close(fd);
+  }
+  return NULL;
+}
+
+static int start_ctl_socket(const char *path)
+{
+  struct sockaddr_un addr = {.sun_family = AF_UNIX};
+  if (strlen(path) >= sizeof(addr.sun_path)) {
+    LOG_E(NR_PHY, "AAL compute extension: socket path too long: %s\n", path);
+    return -1;
+  }
+  strcpy(addr.sun_path, path);
+  strcpy(ext.sock_path, path);
+  ext.listen_fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (ext.listen_fd < 0) {
+    LOG_E(NR_PHY, "AAL compute extension: socket(): %s\n", strerror(errno));
+    return -1;
+  }
+  unlink(path);
+  if (bind(ext.listen_fd, (struct sockaddr *)&addr, sizeof(addr)) != 0 || listen(ext.listen_fd, 1) != 0) {
+    LOG_E(NR_PHY, "AAL compute extension: cannot listen on %s: %s\n", path, strerror(errno));
+    close(ext.listen_fd);
+    ext.listen_fd = -1;
+    return -1;
+  }
+  /* the process runs as root (DPDK); the control client does not need to */
+  chmod(path, 0666);
+  atomic_store(&ext.stop, false);
+  threadCreate(&ext.thread, ctl_thread, NULL, "aal_ext_ctl", -1, OAI_PRIORITY_RT_LOW);
+  return 0;
+}
+
+int aal_compute_ext_init(const char *driver_name, const char *ctl_sock, const char *limits_file, const char *initial_config)
+{
+  ext.lpu = lpu_ops_for_driver(driver_name);
+  ext.descriptor_version = 1;
+  memset(ext.limits, 0, sizeof(ext.limits));
+  if (ext.lpu != NULL) {
+    AssertFatal(ext.lpu->nb_params <= AAL_COMPUTE_MAX_PARAMS, "%s publishes too many parameters\n", driver_name);
+    for (int i = 0; i < ext.lpu->nb_params; i++) {
+      const aal_compute_param_t *p = &ext.lpu->params[i];
+      const int32_t hi = p->type == AAL_COMPUTE_TYPE_ENUM ? p->nb_enum_values - 1 : (p->type == AAL_COMPUTE_TYPE_BOOL ? 1 : p->max);
+      AssertFatal(p->min <= p->max && p->min >= (p->type == AAL_COMPUTE_TYPE_INT ? INT32_MIN : 0) && p->max <= hi
+                      && p->default_value >= p->min && p->default_value <= p->max
+                      && (p->default_value - p->min) % param_step(p) == 0,
+                  "%s: inconsistent descriptor for %s\n",
+                  driver_name,
+                  p->name);
+    }
+  }
+
+  if (limits_file != NULL && limits_file[0] != '\0') {
+    if (load_limits(limits_file) != 0)
+      return -1;
+    aal_ext_json_t adjusted = {0};
+    uint32_t version;
+    clamp_to_limits(&version, &adjusted);
+  }
+
+  if (initial_config != NULL && initial_config[0] != '\0') {
+    char buf[AAL_EXT_LINE_MAX];
+    snprintf(buf, sizeof(buf), "%s", initial_config);
+    char *tokens[AAL_EXT_MAX_TOKENS];
+    int nb_tokens = 0;
+    char *save;
+    for (char *t = strtok_r(buf, ",", &save); t != NULL && nb_tokens < AAL_EXT_MAX_TOKENS; t = strtok_r(NULL, ",", &save))
+      tokens[nb_tokens++] = t;
+    const char *bad_token;
+    uint32_t version;
+    const aal_ext_status_t st = set_config(tokens, nb_tokens, &bad_token, &version);
+    if (st != AAL_EXT_OK) {
+      LOG_E(NR_PHY,
+            "AAL compute extension: initial configuration rejected: %s (%s)\n",
+            aal_ext_status_str[st],
+            bad_token != NULL ? bad_token : "");
+      return -1;
+    }
+  }
+
+  for (int i = 0; i < nb_params(); i++) {
+    int32_t min, max;
+    effective_domain(i, &min, &max);
+    LOG_I(NR_PHY, "AAL compute extension: %s publishes %s [%d..%d]\n", driver_name, ext.lpu->params[i].name, min, max);
+  }
+  if (start_ctl_socket(ctl_sock) != 0)
+    return -1;
+  LOG_I(NR_PHY, "AAL compute extension: AALI-C-App operations on %s\n", ctl_sock);
+  return 0;
+}
+
+void aal_compute_ext_shutdown(void)
+{
+  if (ext.listen_fd < 0)
+    return;
+  atomic_store(&ext.stop, true);
+  pthread_join(ext.thread, NULL);
+  close(ext.listen_fd);
+  unlink(ext.sock_path);
+  ext.listen_fd = -1;
+}
diff --git a/openair1/PHY/CODING/nrLDPC_coding/nrLDPC_coding_aal/aal_compute_ext.h b/openair1/PHY/CODING/nrLDPC_coding/nrLDPC_coding_aal/aal_compute_ext.h
new file mode 100644
index 0000000000..9abafde4d6
--- /dev/null
+++ b/openair1/PHY/CODING/nrLDPC_coding/nrLDPC_coding_aal/aal_compute_ext.h
@@ -0,0 +1,103 @@
+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+/*
+ * AAL compute extension: runtime execution parameters of an AAL-LPU.
+ *
+ * The LPU describes the parameters it accepts while its queues keep running (a typed descriptor), the AAL
+ * Implementation intersects that descriptor with the limits set by the infrastructure (IMS -> HAM) and validates
+ * requests generically, by type and range, without knowing what a parameter means. An LPU driver takes part by
+ * registering an aal_compute_lpu_ops_t; a driver that does not register publishes an empty descriptor, so
+ * applications that ignore the extension keep working unchanged.
+ */
+
+#ifndef AAL_COMPUTE_EXT_H
+#define AAL_COMPUTE_EXT_H
+
+#include <stdint.h>
+
+#define AAL_COMPUTE_MAX_PARAMS 16
+#define AAL_COMPUTE_MAX_ENUM_VALUES 8
+/* configuration versions kept in the per-version statistics */
+#define AAL_COMPUTE_STATS_VERSIONS 64
+
+typedef enum {
+  AAL_COMPUTE_TYPE_INT,
+  AAL_COMPUTE_TYPE_ENUM,
+  AAL_COMPUTE_TYPE_BOOL,
+} aal_compute_type_t;
+
+typedef enum {
+  AAL_COMPUTE_CATEGORY_PARALLELISM,
+  AAL_COMPUTE_CATEGORY_BATCHING,
+  AAL_COMPUTE_CATEGORY_MEMORY,
+  AAL_COMPUTE_CATEGORY_OTHER,
+} aal_compute_category_t;
+
+/* the three configurable objects of the AAL Common API (AAL-LPU, profile instance, profile queue) */
+typedef enum {
+  AAL_COMPUTE_SCOPE_LPU,
+  AAL_COMPUTE_SCOPE_PROFILE_INSTANCE,
+  AAL_COMPUTE_SCOPE_PROFILE_QUEUE,
+} aal_compute_scope_t;
+
+/* One entry of the descriptor. ENUM values are carried as the index into enum_values; BOOL as 0 or 1. */
+typedef struct {
+  const char *name;
+  aal_compute_type_t type;
+  int32_t min;
+  int32_t max;
+  int32_t step;
+  int nb_enum_values;
+  const char *enum_values[AAL_COMPUTE_MAX_ENUM_VALUES];
+  int32_t default_value;
+  const char *unit;
+  aal_compute_category_t category;
+  aal_compute_scope_t scope;
+  const char *description;
+} aal_compute_param_t;
+
+typedef struct {
+  uint32_t version;
+  uint64_t t_applied_ns; /* CLOCK_MONOTONIC: the LPU finished applying this version */
+  uint64_t t_first_burst_ns; /* CLOCK_MONOTONIC: first burst processed with this version, 0 if none yet */
+  uint64_t nb_bursts;
+  uint64_t nb_ops;
+  uint64_t busy_ns; /* time spent processing bursts of this version */
+} aal_compute_stats_t;
+
+/*
+ * Implemented by an LPU driver. Values are indexed as the descriptor; the AAL Implementation only calls apply()
+ * with a complete, already validated vector. A new configuration takes effect at the next burst: a burst in progress
+ * finishes with the configuration it started with.
+ */
+typedef struct {
+  /* must equal the bbdev driver name (rte_bbdev_info.drv.driver_name): the AAL Implementation looks the LPU up by it */
+  const char *lpu_handle;
+  int nb_params;
+  const aal_compute_param_t *params;
+  /* applies all values at once and returns the new configuration version */
+  uint32_t (*apply)(const int32_t *values);
+  /* copies the values in force and returns their version */
+  uint32_t (*get)(int32_t *values, uint64_t *t_applied_ns);
+  /* fills up to max entries, most recent version first, and returns how many were filled */
+  int (*get_stats)(aal_compute_stats_t *stats, int max);
+} aal_compute_lpu_ops_t;
+
+/*
+ * Registers the runtime parameters of an LPU driver; called by the driver when its library is loaded (RTE_INIT), so
+ * the AAL Implementation needs no knowledge of the driver. Returns 0, or -1 if the registry is full or the handle is
+ * already registered.
+ */
+int aal_compute_ext_register(const aal_compute_lpu_ops_t *ops);
+
+/*
+ * Starts the extension for the bbdev driven by driver_name: applies the infrastructure limits (limits_file, may be
+ * NULL), then the initial configuration (initial_config, "name=value,name=value", may be NULL), and serves the
+ * AALI-C-App operations on the UNIX socket ctl_sock.
+ */
+int aal_compute_ext_init(const char *driver_name, const char *ctl_sock, const char *limits_file, const char *initial_config);
+void aal_compute_ext_shutdown(void);
+
+#endif
diff --git a/openair1/PHY/CODING/nrLDPC_coding/nrLDPC_coding_aal/bbdev_oai_sw.c b/openair1/PHY/CODING/nrLDPC_coding/nrLDPC_coding_aal/bbdev_oai_sw.c
new file mode 100644
index 0000000000..c00f8a0799
--- /dev/null
+++ b/openair1/PHY/CODING/nrLDPC_coding/nrLDPC_coding_aal/bbdev_oai_sw.c
@@ -0,0 +1,880 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright(c) 2017 Intel Corporation
+ * Copyright(c) 2026 Murilo Schuck
+ */
+
+/*
+ * baseband_oai_sw: software BBDev virtual device (vdev) acting as an LDPC LPU behind the DPDK BBDev API,
+ * so that libldpc_aal.so (nrLDPC_coding_aal.c) runs without an FPGA.
+ *
+ * The processing kernels are not reimplemented: the driver dlopen()s (RTLD_LOCAL) the libldpc.so next to it
+ * and uses its LDPCencoder, LDPCdecoder, nr_rate_matching_ldpc(_rx), nr_interleaving_ldpc and
+ * nr_deinterleaving_ldpc, so the device runs the same code as the CPU path.
+ *
+ * BBDev semantics (reference: drivers/baseband/turbo_sw, DPDK 24.11):
+ *   ENC: input (K-F)/8 bytes per CB, MSB first, CRC included;
+ *        output ceil(E/8) bytes, MSB first, after rate matching and interleaving.
+ *   DEC: input E int8 LLRs in transmission order;
+ *        output (K-F)/8 bytes, or (K-F-24)/8 with CRC_TYPE_24B_DROP, MSB first.
+ *   HARQ: internal device memory (advertised in the capabilities); the slot is
+ *        harq_combined_output.offset / LDPC_MAX_CB_SIZE, as nrLDPC_coding_aal.c lays out internal memory.
+ *
+ * The control path (device info, queue setup, ring-based enqueue/dequeue, probe) is derived from the DPDK
+ * baseband_null driver (drivers/baseband/null/bbdev_null.c).
+ *
+ * With ENABLE_LDPC_AAL_EXT, the device also publishes runtime execution parameters (aal_compute_ext.h): the code
+ * blocks of a decoding burst are processed serially (oai_sw.mode=seq) or by oai_sw.workers tasks of an OAI thread
+ * pool, each taking oai_sw.batch code blocks at a time (oai_sw.mode=par). Code blocks are independent (each has its
+ * own HARQ slot and output mbuf), so the output does not depend on the configuration.
+ */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE /* dladdr / Dl_info */
+#endif
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <dlfcn.h>
+#include <libgen.h>
+#include <limits.h>
+#include <stdbool.h>
+
+#include <rte_common.h>
+#include <rte_malloc.h>
+#include <rte_ring.h>
+#include <rte_mbuf.h>
+#include <bus_vdev_driver.h>
+
+#include <rte_bbdev.h>
+#include <rte_bbdev_pmd.h>
+
+#include "nrLDPC_coding_aal.h" /* LDPC_MAX_CB_SIZE */
+#include "PHY/CODING/coding_defs.h" /* crcType, lenWithCrc, check_crc, nr_get_R_ldpc_decoder */
+#include "PHY/CODING/nrLDPC_defs.h" /* encoder_implemparams_t, LDPC_*func_t, t_nrLDPC_dec_params */
+
+#ifdef ENABLE_LDPC_AAL_EXT
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <time.h>
+#include <rte_lcore.h>
+#include "common/utils/threadPool/thread-pool.h"
+#include "common/utils/threadPool/task_ans.h"
+#include "aal_compute_ext.h"
+#endif
+
+#define DRIVER_NAME baseband_oai_sw
+#define OAI_SW_MAX_QUEUES 8
+#define OAI_SW_QUEUE_PRIO_MAX 1 /* add_dev() in nrLDPC_coding_aal.c sets up the DEC queue with priority 1 */
+#define OAI_SW_MAX_HARQ_SLOTS 4096
+#define OAI_SW_D_LEN (68 * 384) /* largest circular buffer (BG1, Z=384), with margin */
+
+#ifndef OAI_LDPC_DECODER_MAX_NUM_LLR
+#define OAI_LDPC_DECODER_MAX_NUM_LLR 27000 /* same as the OAI decoder; >= 68*384 */
+#endif
+
+/* stderr rather than LOG_*: nr_ulsim does not print LOG_I, and these lines are the evidence of which device and
+ * kernels a run used */
+#define OAI_SW_LOG(fmt, ...) fprintf(stderr, "[OAI_SW] " fmt "\n", ##__VA_ARGS__)
+
+/* ------------------------------------------------------------------------ */
+/* libldpc.so kernels (dlopen)                                               */
+/* ------------------------------------------------------------------------ */
+typedef int (*rm_tx_fn)(uint32_t, uint8_t, uint16_t, uint8_t *, uint8_t *, uint8_t, uint32_t, uint32_t, uint8_t, uint32_t);
+typedef int (*rm_rx_fn)(uint32_t, uint8_t, uint16_t, int16_t *, int16_t *, uint8_t, uint8_t, uint8_t, uint32_t, uint32_t, uint32_t);
+typedef void (*il_fn)(uint32_t, uint8_t, uint8_t *, uint8_t *);
+typedef void (*deil_fn)(uint32_t, uint8_t, int16_t *, int16_t *);
+typedef int (*getR_fn)(int, int, int, int, int *, int);
+typedef int (*crc_fn)(uint8_t *, uint32_t, uint8_t);
+
+static struct {
+  void *handle;
+  LDPC_encoderfunc_t *encoder;
+  LDPC_decoderfunc_t *decoder;
+  rm_tx_fn rate_matching;
+  rm_rx_fn rate_matching_rx;
+  il_fn interleaving;
+  deil_fn deinterleaving;
+  getR_fn get_R; /* optional, from the executable */
+  crc_fn check_crc;
+} oai;
+
+static int oai_sw_load_kernels(void)
+{
+  if (oai.handle != NULL)
+    return 0;
+
+  /* libldpc.so lives in the same directory as this libldpc_aal.so */
+  Dl_info info;
+  char path[PATH_MAX];
+  if (dladdr((void *)&oai_sw_load_kernels, &info) == 0 || info.dli_fname == NULL)
+    return -1;
+  char self[PATH_MAX];
+  snprintf(self, sizeof(self), "%s", info.dli_fname);
+  snprintf(path, sizeof(path), "%s/libldpc.so", dirname(self));
+
+  oai.handle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+  if (oai.handle == NULL) {
+    OAI_SW_LOG("cannot load %s: %s", path, dlerror());
+    return -1;
+  }
+
+#define LOAD(field, name)                                \
+  do {                                                   \
+    *(void **)(&oai.field) = dlsym(oai.handle, name);    \
+    if (oai.field == NULL) {                             \
+      OAI_SW_LOG("symbol %s missing in %s", name, path); \
+      return -1;                                         \
+    }                                                    \
+  } while (0)
+  LOAD(encoder, "LDPCencoder");
+  LOAD(decoder, "LDPCdecoder");
+  LOAD(rate_matching, "nr_rate_matching_ldpc");
+  LOAD(rate_matching_rx, "nr_rate_matching_ldpc_rx");
+  LOAD(interleaving, "nr_interleaving_ldpc");
+  LOAD(deinterleaving, "nr_deinterleaving_ldpc");
+#undef LOAD
+
+  /* resolved from the executable, as nrLDPC_coding_aal.c already does for check_crc */
+  *(void **)(&oai.get_R) = dlsym(RTLD_DEFAULT, "nr_get_R_ldpc_decoder");
+  *(void **)(&oai.check_crc) = dlsym(RTLD_DEFAULT, "check_crc");
+  if (oai.check_crc == NULL) {
+    OAI_SW_LOG("symbol check_crc not found in the process");
+    return -1;
+  }
+  if (oai.get_R == NULL)
+    OAI_SW_LOG("warning: nr_get_R_ldpc_decoder missing; using the lowest rate (all rows of the graph)");
+
+  OAI_SW_LOG("kernels loaded from %s", path);
+  return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Internal HARQ memory                                                      */
+/* ------------------------------------------------------------------------ */
+typedef struct {
+  int16_t *d; /* combined circular buffer, same layout as the CPU path */
+  int llrLen;
+  int round;
+} oai_sw_harq_t;
+
+static oai_sw_harq_t harq_mem[OAI_SW_MAX_HARQ_SLOTS];
+
+static oai_sw_harq_t *harq_slot(uint32_t offset)
+{
+  uint32_t idx = (offset / LDPC_MAX_CB_SIZE) % OAI_SW_MAX_HARQ_SLOTS;
+  oai_sw_harq_t *h = &harq_mem[idx];
+  if (h->d == NULL)
+    h->d = aligned_alloc(64, (OAI_SW_D_LEN + 64) * sizeof(int16_t));
+  return h;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Helpers                                                                   */
+/* ------------------------------------------------------------------------ */
+static inline uint32_t mother_len(uint8_t BG, uint16_t Z)
+{
+  return (BG == 1 ? 66 : 50) * Z;
+}
+
+/*
+ * The BBDev op carries n_cb, while the OAI kernels take Tbslbrm and C. Tbslbrm = 0 makes OAI use Ncb = N
+ * (no LBRM); otherwise find Tbslbrm with C = 2 such that floor(3*T/(2*C)) = n_cb (TS 38.212 §5.4.2.1,
+ * R_LBRM = 2/3).
+ */
+static inline void tbslbrm_from_ncb(uint32_t n_cb, uint8_t BG, uint16_t Z, uint32_t *T, uint8_t *C)
+{
+  *C = 1;
+  *T = 0;
+  if (n_cb >= mother_len(BG, Z))
+    return;
+  *C = 2;
+  uint32_t guess = (4 * n_cb) / 3;
+  for (uint32_t t = (guess > 3 ? guess - 3 : 0); t < guess + 4; t++)
+    if ((3 * t) / 4 == n_cb) {
+      *T = t;
+      return;
+    }
+  OAI_SW_LOG("warning: n_cb=%u has no matching Tbslbrm; using Ncb=N", n_cb);
+  *C = 1;
+}
+
+/* BG2: Kb is the smallest of {6,8,9,10} with Kb*Z >= K' (TS 38.212 §5.2.2) */
+static inline uint32_t kb_from(uint8_t BG, uint16_t Z, uint32_t Kprime)
+{
+  if (BG == 1)
+    return 22;
+  const uint32_t kbs[] = {6, 8, 9, 10};
+  for (int i = 0; i < 4; i++)
+    if (kbs[i] * Z >= Kprime)
+      return kbs[i];
+  return 10;
+}
+
+static inline uint8_t *mbuf_append_bytes(struct rte_mbuf *m, uint32_t offset, uint32_t len)
+{
+  if (rte_pktmbuf_append(m, len) == NULL)
+    return NULL;
+  return rte_pktmbuf_mtod_offset(m, uint8_t *, offset);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Encoder (one code block per op)                                           */
+/* ------------------------------------------------------------------------ */
+static void process_ldpc_enc(struct rte_bbdev_enc_op *op)
+{
+  struct rte_bbdev_op_ldpc_enc *enc = &op->ldpc_enc;
+  op->status = 0;
+
+  const uint8_t BG = enc->basegraph;
+  const uint16_t Z = enc->z_c;
+  const uint32_t K = (BG == 1 ? 22 : 10) * Z;
+  const uint32_t F = enc->n_filler;
+  const uint32_t in_bytes = (K - F + 7) >> 3;
+  const uint32_t E = (enc->code_block_mode == RTE_BBDEV_CODE_BLOCK) ? enc->cb_params.e : enc->tb_params.ea;
+
+  /* input is (K-F)/8 bytes; the OAI encoder expects K bits with zeroed fillers */
+  uint8_t c[(68 * 384) / 8 + 64] __attribute__((aligned(64)));
+  memset(c, 0, (K >> 3) + 64);
+  uint8_t *in = rte_pktmbuf_mtod_offset(enc->input.data, uint8_t *, enc->input.offset);
+  memcpy(c, in, in_bytes);
+
+  /* output d holds one bit per byte (bit 0 = this code block) */
+  uint8_t d[68 * 384 + 64] __attribute__((aligned(64)));
+  memset(d, 0, sizeof(d));
+  uint8_t *cs[1] = {c};
+  time_stats_t t0 = {0}, t1 = {0}, t2 = {0}, t3 = {0};
+  encoder_implemparams_t impp = {
+      .n_segments = 1,
+      .first_seg = 0,
+      .gen_code = 0,
+      .tinput = &t0,
+      .tprep = &t1,
+      .tparity = &t2,
+      .toutput = &t3,
+      .K = K,
+      .Kb = kb_from(BG, Z, K - F),
+      .Zc = Z,
+      .F = F,
+      .BG = BG,
+      .output = NULL,
+      .ans = NULL,
+  };
+  oai.encoder(cs, d, &impp);
+
+  /* rate matching + interleaving */
+  uint32_t T;
+  uint8_t C;
+  tbslbrm_from_ncb(enc->n_cb, BG, Z, &T, &C);
+  uint8_t e[E + 64] __attribute__((aligned(64)));
+  uint8_t f[E + 128] __attribute__((aligned(64)));
+  memset(e, 0, E + 64);
+  memset(f, 0, E + 128);
+  if (oai.rate_matching(T, BG, Z, d, e, C, F, K - F - 2 * Z, enc->rv_index, E) != 0) {
+    op->status |= 1 << RTE_BBDEV_DRV_ERROR;
+    return;
+  }
+  oai.interleaving(E, enc->q_m, e, f);
+
+  /* output: ceil(E/8) bytes, MSB first (nrLDPC_coding_aal.c reverses the bit order) */
+  const uint32_t out_len = (E + 7) >> 3;
+  uint8_t *out = mbuf_append_bytes(enc->output.data, enc->output.offset, out_len);
+  if (out == NULL) {
+    op->status |= 1 << RTE_BBDEV_DATA_ERROR;
+    return;
+  }
+  memset(out, 0, out_len);
+  for (uint32_t i = 0; i < E; i++)
+    out[i >> 3] |= (f[i] & 1) << (7 - (i & 7));
+  enc->output.length += out_len;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Decoder (one code block per op)                                           */
+/* ------------------------------------------------------------------------ */
+static void process_ldpc_dec(struct rte_bbdev_dec_op *op)
+{
+  struct rte_bbdev_op_ldpc_dec *dec = &op->ldpc_dec;
+  op->status = 0;
+
+  const uint8_t BG = dec->basegraph;
+  const uint16_t Z = dec->z_c;
+  const uint32_t K = (BG == 1 ? 22 : 10) * Z;
+  const uint32_t F = dec->n_filler;
+  const uint32_t Kprime = K - F;
+  const uint8_t Kc = (BG == 2) ? 52 : 68;
+  const bool cb_mode = (dec->code_block_mode == RTE_BBDEV_CODE_BLOCK);
+  const uint32_t E = cb_mode ? dec->cb_params.e : dec->tb_params.ea;
+  const bool crc24b = (dec->op_flags & RTE_BBDEV_LDPC_CRC_TYPE_24B_CHECK) != 0;
+  const bool crc_drop = (dec->op_flags & RTE_BBDEV_LDPC_CRC_TYPE_24B_DROP) != 0;
+  const bool combine_in = (dec->op_flags & RTE_BBDEV_LDPC_HQ_COMBINE_IN_ENABLE) != 0;
+
+  /* 1. int8 -> int16 LLRs and deinterleaving */
+  int8_t *in = rte_pktmbuf_mtod_offset(dec->input.data, int8_t *, dec->input.offset);
+  int16_t llr[E + 64] __attribute__((aligned(64)));
+  int16_t harq_e[E + 64] __attribute__((aligned(64)));
+  for (uint32_t i = 0; i < E; i++)
+    llr[i] = in[i];
+  memset(llr + E, 0, 64 * sizeof(int16_t));
+  oai.deinterleaving(E, dec->q_m, harq_e, llr);
+
+  /* 2. rate recovery with HARQ combining in internal memory */
+  oai_sw_harq_t *h = harq_slot(dec->harq_combined_output.offset);
+  if (h->d == NULL) {
+    op->status |= 1 << RTE_BBDEV_DRV_ERROR;
+    return;
+  }
+  if (!combine_in) {
+    h->llrLen = 0;
+    h->round = 0;
+  } else {
+    h->round++;
+  }
+  uint32_t T;
+  uint8_t C;
+  tbslbrm_from_ncb(dec->n_cb, BG, Z, &T, &C);
+  if (oai.rate_matching_rx(T, BG, Z, h->d, harq_e, C, dec->rv_index, combine_in ? 0 : 1, E, F, K - F - 2 * Z) != 0) {
+    op->status |= 1 << RTE_BBDEV_DRV_ERROR;
+    return;
+  }
+
+  /* 3. decoder parameters, as in nrLDPC_prepare_TB_decoding() */
+  t_nrLDPC_dec_params p = {0};
+  p.BG = BG;
+  p.Z = Z;
+  p.numMaxIter = dec->iter_max;
+  p.outMode = nrLDPC_outMode_BIT;
+  p.check_crc = oai.check_crc;
+  if (oai.get_R)
+    p.R = oai.get_R(dec->rv_index, E, BG, Z, &h->llrLen, h->round);
+  else
+    p.R = (BG == 1) ? 13 : 15;
+  if (cb_mode && crc24b) {
+    p.crc_type = CRC24_B;
+    p.Kprime = Kprime;
+  } else {
+    /* single-CB TB: CRC24A if K' > 3840, else CRC16 (TS 38.212 §6.2.1, §7.2.1) */
+    p.crc_type = (Kprime > 3840) ? CRC24_A : CRC16;
+    p.Kprime = Kprime;
+  }
+
+  /* 4. decoder input vector, as in nr_process_decode_segment() */
+  int16_t z[68 * 384 + 16] __attribute__((aligned(16)));
+  memset(z, 0, 2 * Z * sizeof(*z));
+  for (uint32_t i = 0; i < F; i++)
+    z[Kprime + i] = 127;
+  memcpy(z + 2 * Z, h->d, (Kprime - 2 * Z) * sizeof(*z));
+  memcpy(z + K, h->d + (K - 2 * Z), (Kc * Z - K) * sizeof(*z));
+  int8_t l[68 * 384 + 16] __attribute__((aligned(16)));
+  for (uint32_t i = 0; i < (uint32_t)Kc * Z; i++)
+    l[i] = (int8_t)RTE_MAX(-128, RTE_MIN(127, (int)z[i]));
+  memset(l + Kc * Z, 0, 16);
+
+  /* 5. decoding */
+  int8_t out_buf[OAI_LDPC_DECODER_MAX_NUM_LLR] __attribute__((aligned(32)));
+  t_nrLDPC_time_stats ts;
+  memset(&ts, 0, sizeof(ts));
+  decode_abort_t ab;
+  memset(&ab, 0, sizeof(ab));
+  int iters = oai.decoder(&p, l, (uint8_t *)out_buf, &ts, &ab);
+  dec->iter_count = RTE_MAX((uint8_t)RTE_MIN(iters, 255), dec->iter_count);
+  if (iters >= p.numMaxIter) {
+    op->status |= 1 << RTE_BBDEV_SYNDROME_ERROR;
+    if (crc24b)
+      op->status |= 1 << RTE_BBDEV_CRC_ERROR;
+  }
+
+  /* 6. hard output: (K-F)/8 bytes, or (K-F-24)/8 with CRC24B dropped */
+  const uint32_t out_len = (Kprime - (crc_drop ? 24 : 0)) >> 3;
+  uint8_t *out = mbuf_append_bytes(dec->hard_output.data, dec->hard_output.offset, out_len);
+  if (out == NULL) {
+    op->status |= 1 << RTE_BBDEV_DATA_ERROR;
+    return;
+  }
+  memcpy(out, out_buf, out_len);
+  dec->hard_output.length += out_len;
+
+  /* internal HARQ memory: nothing to copy out, only report the buffer length */
+  dec->harq_combined_output.length = mother_len(BG, Z);
+}
+
